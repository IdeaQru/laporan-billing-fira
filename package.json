{
  "name": "laporan-wifi-billing",
  "version": "1.0.0",
  "description": "Website & Database Laporan Billing Wifi",
  "type": "module",
  "scripts": {
    "migrate": "node src/infrastructure/etl/migrate_excel_to_sqlite.js",
    "dev:server": "node src/server/index.js",
    "dev:web": "cd web && npm run dev",
